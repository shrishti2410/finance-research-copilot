# Environment for the free-tier deploy in docs/DEPLOY.md: Render (API),
# Neon (Postgres), Upstash (Redis), Groq (model), Vercel (front end).
#
# These go into the Render dashboard (Environment), one per line. This file is
# a checklist, not something to upload. Every value marked CHANGE ME is a
# placeholder that the app refuses at boot (ENVIRONMENT=production), so a
# copied-but-unedited value fails loudly instead of working.

ENVIRONMENT=production

# --- Secrets: generate or copy each one; never commit them ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Neon dashboard > Connect > the direct (not "-pooler") connection string.
DATABASE_URL=postgresql://CHANGE_ME@127.0.0.1/neondb?sslmode=require
# Upstash console > the database > TLS endpoint: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379/0
GROQ_API_KEY=
# SEC asks for a real contact. Your own address, not this placeholder.
SEC_EDGAR_USER_AGENT=finance-research-copilot (contact: set SEC_EDGAR_USER_AGENT)

# --- The front end's exact origin: https, no trailing slash ---
CORS_ORIGINS=http://localhost:3000

# --- Model: Groq, one model for both steps ---
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-120b
AGENT_ROUTER_MODEL=openai/gpt-oss-120b
AGENT_MAX_TOKENS=2048

# --- What visitors may spend (api/quotas.py) ---
# Tokens sent to Groq per UTC day, all visitors together. Groq's free tier is
# 200,000 a day for this model and the same key also serves your evals: leave
# room for them. 0 is refused in production.
HOSTED_TOKENS_PER_DAY=0
SIGNUP_ENABLED=false
DEMO_ENABLED=true
DEMO_QUESTIONS_PER_ACCOUNT=5
DEMO_QUESTIONS_PER_DAY=0

# --- One 0.1-CPU instance: one embedding thread, model loaded at start ---
# Measured under docker --cpus=0.1 (docs/DEPLOY.md section 0): 55 s per query
# embedding with torch's default threads, 0.4-0.6 s with one.
EMBEDDING_THREADS=1
OMP_NUM_THREADS=1
EMBEDDING_PRELOAD=true

# --- Small pool: a free Postgres and one 0.1-CPU instance ---
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
# Leave false until Render's handling of X-Forwarded-For is confirmed; see
# docs/DEPLOY.md, "What is not verified".
RATE_LIMIT_TRUST_PROXY=false
