# ─────────────────────────────────────────────────────────────
# Finance Research Copilot — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Self-hosted inference (vLLM / Ollama / llama.cpp) ---
# Any OpenAI-compatible server. Only these three lines change between engines.
# See docs/INFERENCE.md for setup.
#
#   vLLM  (GPU, prod):  http://127.0.0.1:8001/v1   + qwen2.5-7b-instruct
#   Ollama (CPU, dev):  http://127.0.0.1:11434/v1  + qwen2.5:1.5b-instruct
INFERENCE_BASE_URL=http://127.0.0.1:8001/v1
INFERENCE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
INFERENCE_API_KEY=
INFERENCE_CONNECT_TIMEOUT=5
INFERENCE_READ_TIMEOUT=300
# Total wall-clock cap on one model call. The read timeout only bounds silence,
# so a stream that trickles bytes never trips it. See docs/INFERENCE.md.
INFERENCE_CALL_DEADLINE=900

# --- Hosted LLM (optional alternative to self-hosting) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---
# Provider for turning text into vectors (ingestion + query time).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Vector store ---
# e.g. "chroma" (local) or a hosted provider name.
VECTOR_STORE=chroma
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=sec_filings

# --- SEC EDGAR ---
# EDGAR requires a descriptive User-Agent with a real contact address, and may
# throttle or block anonymous callers. Set this before any sustained crawling.
# SEC requires a name and a contact it can actually reach; it throttles or
# blocks callers without one. Validated at startup -- EdgarClient refuses to
# construct if this is missing, has no contact, or uses a reserved domain
# like example.com. An http(s) URL is accepted in place of an email.
SEC_EDGAR_USER_AGENT=finance-research-copilot/0.1 (you@yourdomain.com)
# SEC's published ceiling is 10 requests/second across all of edgar.
SEC_REQUESTS_PER_SECOND=5
# Downloaded filings are cached here (gitignored) so reruns cost SEC nothing.
EDGAR_CACHE_DIR=data/edgar

# --- Market data (stock price / fundamentals tool) ---
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# --- News search tool ---
NEWS_API_KEY=
NEWS_API_BASE_URL=

# --- Database ---
# Postgres 13+ (gen_random_uuid() is core from 13 on).
# The app uses asyncpg; Alembic reads this same URL via core/config.py.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/finance_copilot
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Auth ---
# JWT_SECRET must be set to a real random value before this is exposed to a
# network -- the built-in default is public knowledge.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# --- Rate limiting ---
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=60          # authenticated, keyed by user id
RATE_LIMIT_ANON_PER_MINUTE=20     # unauthenticated, keyed by IP
RATE_LIMIT_AUTH_PER_MINUTE=10     # /auth/* only, keyed by IP (brute-force surface)
# true  = a Redis outage serves traffic unlimited (availability first)
# false = a Redis outage returns 503 (enforcement first)
RATE_LIMIT_FAIL_OPEN=true
# Only enable behind a proxy that overwrites X-Forwarded-For, or callers can
# spoof the header and give themselves a fresh bucket per request.
RATE_LIMIT_TRUST_PROXY=false

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Agent ---
AGENT_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
AGENT_MODEL=qwen2.5:7b
AGENT_MAX_ITERATIONS=5
# Tool calls run inside one iteration. Iterations bound model round-trips;
# this bounds the work, because parallel tool calls all land in one turn.
AGENT_MAX_TOOL_CALLS_PER_ITERATION=8
# Prior messages replayed so a follow-up can resolve a reference. 0 makes
# every question standalone.
AGENT_HISTORY_MESSAGES=10
# Lets the process skip rate limiting on its own loopback calls to /v1.
# Generated randomly per process if unset, which is fine when the agent
# runs inside the API process. Set it explicitly when they are separate
# processes (a worker, or scripts/agent_demo.py), or the caller's quota
# pays for the agent's own inference calls.
INTERNAL_TOKEN=change-me-any-random-string
