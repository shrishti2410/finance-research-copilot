# ─────────────────────────────────────────────────────────────────────────────
# The deployment delta: what changes in .env when this stops being localhost.
#
# NOT a replacement for .env.example. Copy .env.example to .env as usual, then
# change only the lines below. Everything else -- token caps, iteration limits,
# timeouts, SEC rate limit -- is already right.
#
# What is deliberately NOT here: DATABASE_URL, REDIS_URL, INFERENCE_BASE_URL,
# AGENT_INFERENCE_BASE_URL, EDGAR_CACHE_DIR. Those are topology, and
# docker-compose.yml sets them in `environment:`, which overrides this file. You
# do not need to edit them for a container deployment and should not: the
# compose file is where "which host is Postgres on" is answered.
# ─────────────────────────────────────────────────────────────────────────────


# ── required: the deployment will not start without this ─────────────────────

# Every token the app issues is signed with this. The built-in default is in the
# source, so leaving it unset means anyone can forge a token for any user. The
# app only logs a warning; docker-compose.yml refuses to start instead.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=


# ── required: or the browser silently cannot talk to the API ─────────────────

# The origin the browser will be on. CORS is an explicit allow-list and never
# "*", because these requests carry a bearer token -- so an origin missing from
# here produces a frontend that loads, renders, and fails every request with a
# CORS error visible only in the browser console.
#
# Include the public origin. Keep the localhost entries only if you also tunnel.
#
#   Lambda / any VM with a public IP   http://203.0.113.10:3000
#   RunPod proxy                       https://abc123xyz-3000.proxy.runpod.net
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── required: SEC blocks anonymous callers ───────────────────────────────────

# A real, reachable contact. EdgarClient refuses to construct without one, and
# rejects reserved domains like example.com. This is the address SEC contacts
# before blocking the IP, and a cloud IP is shared, so a wrong value here is
# somebody else's problem too.
SEC_EDGAR_USER_AGENT=finance-research-copilot/0.1 (you@yourdomain.com)


# ── strongly recommended ─────────────────────────────────────────────────────

# Read by docker-compose.yml only, not by the app. The Postgres container is
# published on loopback and reachable only over the compose network, so the
# default is not directly exposed -- but "postgres" as a production password is
# one misconfigured port away from being the whole story.
POSTGRES_PASSWORD=postgres

# Read by docker-compose.yml as the frontend image's build argument. This is the
# URL the *visitor's browser* calls, compiled into the JavaScript at build time
# -- so it cannot be http://backend:8000 (a compose-internal name the browser
# cannot resolve) and cannot be changed without rebuilding the frontend image.
#
#   Lambda / any VM with a public IP   http://203.0.113.10:8000
#   RunPod proxy                       https://abc123xyz-8000.proxy.runpod.net
PUBLIC_API_BASE=http://127.0.0.1:8000


# ── consider, depending on how the host is fronted ───────────────────────────

# Leave false unless a proxy you control overwrites X-Forwarded-For. With it
# true and no such proxy, any caller sets their own rate-limit key by sending
# the header, which is worse than the alternative.
#
# Behind a provider proxy (RunPod) the trade-off is real but one-sided: left
# false, every anonymous caller shares one bucket keyed on the proxy's address,
# so the anonymous limit becomes global. That is stricter, not weaker, and
# authenticated callers are keyed by user id and unaffected. Strict is the safe
# direction; keep false unless the provider documents that it overwrites the
# header.
RATE_LIMIT_TRUST_PROXY=false

# A Redis outage currently serves traffic with no limits at all. On a host
# exposed to the internet, consider false -- 503 while Redis restarts, rather
# than an unmetered window nobody can see. /health/redis reports which is in
# effect and whether limiting is actually happening.
RATE_LIMIT_FAIL_OPEN=true
